{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Paradigm.Enterprise.Interfaces/bin/Release/netstandard2.0/Paradigm.Enterprise.Interfaces.dll",
            "Paradigm.Enterprise.Domain/bin/Release/net10.0/Paradigm.Enterprise.Domain.dll",
            "Paradigm.Enterprise.Data/bin/Release/net10.0/Paradigm.Enterprise.Data.dll",
            "Paradigm.Enterprise.Data.SqlServer/bin/Release/net10.0/Paradigm.Enterprise.Data.SqlServer.dll",
            "Paradigm.Enterprise.Data.PostgreSql/bin/Release/net10.0/Paradigm.Enterprise.Data.PostgreSql.dll",
            "Paradigm.Enterprise.Providers/bin/Release/net10.0/Paradigm.Enterprise.Providers.dll",
            "Paradigm.Enterprise.Services.Core/bin/Release/net10.0/Paradigm.Enterprise.Services.Core.dll",
            "Paradigm.Enterprise.Services.BlobStorage/bin/Release/net10.0/Paradigm.Enterprise.Services.BlobStorage.dll",
            "Paradigm.Enterprise.Services.Cache/bin/Release/net10.0/Paradigm.Enterprise.Services.Cache.dll",
            "Paradigm.Enterprise.Services.Email/bin/Release/net10.0/Paradigm.Enterprise.Services.Email.dll",
            "Paradigm.Enterprise.Services.TableReader/bin/Release/net10.0/Paradigm.Enterprise.Services.TableReader.dll",
            "Paradigm.Enterprise.WebApi/bin/Release/net10.0/Paradigm.Enterprise.WebApi.dll"
          ]
        }
      ],
      "dest": "api",
      "namespaceLayout": "nested",
      "memberLayout": "samePage"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "PK_Migration/**",
          "_site/**",
          "api/**",
          "handoffs/**",
          "rfc/**",
          "rules/**"
        ]
      },
      {
        "files": [
          "api/**.{yml,md}"
        ]
      }
    ],
    "resource": [
      {
        "src": "../src/Paradigm.Enterprise.WebApi",
        "files": [
          "icon.png"
        ],
        "dest": "media"
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "templates/enterprise"
    ],
    "globalMetadata": {
      "_appName": "Paradigm.Enterprise",
      "_appTitle": "Paradigm.Enterprise documentation",
      "_appLogoPath": "media/icon.png",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_lang": "en",
      "_gitContribute": {
        "repo": "https://github.com/MiracleDevs/Paradigm.Enterprise",
        "branch": "main"
      }
    },
    "sitemap": {
      "baseUrl": "https://miracledevs.github.io/Paradigm.Enterprise/"
    }
  }
}
