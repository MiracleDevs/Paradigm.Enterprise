{
  "$schema": "http://json.schemastore.org/template",
  "author": "Miracle Devs",
  "classifications": ["Web", "Web API", "Paradigm"],
  "identity": "MiracleDevs.Paradigm.Enterprise.WebApi.CSharp",
  "name": "Paradigm Web API",
  "description": "A layered Paradigm.Enterprise Web API solution with NuGet Central Package Management and Scalar API documentation.",
  "shortName": "paradigm-webapi",
  "sourceName": "Paradigm.Web.ApiTemplate",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sources": [
    {
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/.vs/**",
        ".template.config/**",
        "**/*.user",
        "**/*.suo"
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "Paradigm.Web.ApiTemplate.slnx" }
  ]
}
