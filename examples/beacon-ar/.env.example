Database__Provider=SqlServer
Database__Mode=Managed
Database__Name=BeaconAr
Database__Password=<set-locally>
Database__PublishOnStart=true
ConnectionStrings__DatabaseConnection=<required-only-for-external>
# Release one accepts delegated Entra user tokens only; client-credentials actors are forbidden.
AzureAd__Instance=https://login.microsoftonline.com/
AzureAd__TenantId=<tenant-id>
AzureAd__ClientId=<beacon-api-client-id>
AzureAd__AllowWebApiToBeAuthorizedByACL=true
Authentication__Permissions__Read=business.read
Authentication__Permissions__Write=business.write
Cors__AllowedOrigins__0=https://localhost:4200
