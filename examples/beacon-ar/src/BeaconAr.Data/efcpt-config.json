{
  "$schema": "https://raw.githubusercontent.com/ErikEJ/EFCorePowerTools/master/samples/efcpt-config.schema.json",
  "tables": [
    { "name": "[dbo].[AddressType]" },
    { "name": "[dbo].[ApplicationUser]" },
    { "name": "[dbo].[AuditLog]" },
    { "name": "[dbo].[Carrier]" },
    { "name": "[dbo].[Customer]" },
    { "name": "[dbo].[CustomerAddress]" },
    { "name": "[dbo].[IdempotencyRequest]" },
    { "name": "[dbo].[IdempotencyState]" },
    { "name": "[dbo].[Product]" },
    { "name": "[dbo].[Quote]" },
    { "name": "[dbo].[QuoteLine]" },
    { "name": "[dbo].[QuoteStatus]" },
    { "name": "[dbo].[QuoteStatusHistory]" },
    { "name": "[dbo].[SalesOrder]" },
    { "name": "[dbo].[SalesOrderLine]" },
    { "name": "[dbo].[SalesOrderStatus]" },
    { "name": "[dbo].[SalesOrderStatusHistory]" }
  ],
  "views": [
    { "name": "[dbo].[ApplicationUserView]" },
    { "name": "[dbo].[CarrierView]" },
    { "name": "[dbo].[CustomerView]" },
    { "name": "[dbo].[CustomerAddressView]" },
    { "name": "[dbo].[ProductView]" },
    { "name": "[dbo].[QuoteView]" },
    { "name": "[dbo].[QuoteLineView]" },
    { "name": "[dbo].[SalesOrderView]" },
    { "name": "[dbo].[SalesOrderLineView]" },
    { "name": "[dbo].[QuotePricing]" },
    { "name": "[dbo].[SalesOrderPricing]" }
  ],
  "stored-procedures": [
    { "exclusionWildcard": "*" }
  ],
  "functions": [
    { "exclusionWildcard": "*" }
  ],
  "code-generation": {
    "enable-on-configuring": false,
    "type": "all",
    "use-database-names": true,
    "use-data-annotations": false,
    "use-nullable-reference-types": true,
    "use-inflector": true,
    "use-legacy-inflector": false,
    "use-many-to-many-entity": false,
    "use-t4": true,
    "remove-defaultsql-from-bool-properties": false,
    "soft-delete-obsolete-files": false,
    "use-alternate-stored-procedure-resultset-discovery": false,
    "use-stored-procedure-resultset-fallback": true,
    "t4-template-path": ".",
    "refresh-object-lists": false,
    "generate-mermaid-diagram": false
  },
  "names": {
    "root-namespace": "",
    "dbcontext-name": "ReceivablesDbContext",
    "dbcontext-namespace": "BeaconAr.Data.Receivables.Context",
    "model-namespace": "BeaconAr.Domain.Receivables.Entities"
  },
  "file-layout": {
    "output-path": "../BeaconAr.Domain/Receivables/Entities",
    "output-dbcontext-path": "Receivables/Context",
    "split-dbcontext-preview": false,
    "use-schema-folders-preview": false,
    "use-schema-namespaces-preview": false
  },
  "type-mappings": {
    "use-DateOnly-TimeOnly": true,
    "use-HierarchyId": false,
    "use-spatial": false,
    "use-NodaTime": false
  },
  "replacements": {
    "preserve-casing-with-regex": true
  }
}
