{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "experimentalDecorators": true,
    "noEmit": true,
    "skipLibCheck": false,
    "useDefineForClassFields": true
  },
  "include": ["generated/**/*.ts", "consumer.ts"]
}
