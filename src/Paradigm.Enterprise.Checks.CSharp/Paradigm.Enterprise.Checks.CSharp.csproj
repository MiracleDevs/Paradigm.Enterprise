<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>paradigm-checks-csharp</ToolCommandName>
    <PackageId>Paradigm.Enterprise.Checks.CSharp</PackageId>
    <Authors>Miracle Devs</Authors>
    <Company>Miracle Devs</Company>
    <Description>Process-isolated Roslyn checks for Paradigm.Enterprise application source.</Description>
    <PackageProjectUrl>https://github.com/MiracleDevs/Paradigm.Enterprise</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MiracleDevs/Paradigm.Enterprise.git</RepositoryUrl>
    <PackageTags>paradigm enterprise checks roslyn</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
</Project>
